rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default allow authenticated users to read and write their own documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Public read access for community or shared resources if unauthenticated
    match /public/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
